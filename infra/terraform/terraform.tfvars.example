# Copy to terraform.tfvars and fill in your own values (terraform.tfvars is git-ignored)
aws_region            = "ap-south-1"
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidr    = "10.0.1.0/24"
public_2_subnet_cidr  = "10.0.3.0/24"
private_subnet_cidr   = "10.0.2.0/24"
private_2_subnet_cidr = "10.0.6.0/24"

ssh_allowed_cidr = "<your-public-ip>/32"
key_name         = "my-terraform-key"

# AMIs baked from the configured Phase-1 instances (Nginx + React / Node.js + pm2)
frontend_ami_id = "ami-0c5f4e7d1055311d2"
backend_ami_id  = "ami-03d279a3d5d60d459"

frontend_instance_type = "t3.micro"
backend_instance_type  = "t3.micro"

backend_port_api = 3001
backend_port_ssh = 22

# ACM certificate for travelmemory.samibrahima.tech (status: Issued)
acm_certificate_arn = "arn:aws:acm:ap-south-1:<account-id>:certificate/<certificate-id>"
